# Copy this file to .env and update the values.

# PostgreSQL connection string for the backend database.
# Example:
# POSTGRES_URL=postgres://<user>:<password>@<host>:<port>/<database>
POSTGRES_URL=

# Optional database name override. Default is mizpah-online.
POSTGRES_DB=mizpah-online

# Enforce database-only persistence. When true, the server rejects writes unless POSTGRES_URL is configured.
ENFORCE_DB=true

# Local server settings
PORT=3000
HOST=127.0.0.1
